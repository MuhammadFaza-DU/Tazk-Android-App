<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/calendar_widget_container"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/widget_background"
  android:padding="4dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="20dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView
      android:id="@+id/calendar_prev"
      android:layout_width="26dp"
      android:layout_height="20dp"
      android:gravity="center"
      android:text="&#8249;"
      android:textColor="@color/widget_primary"
      android:textSize="14sp"
      android:textStyle="bold" />
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/calendar_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Tazk Calendar"
        android:textColor="@color/widget_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>
    <TextView
      android:id="@+id/calendar_next"
      android:layout_width="26dp"
      android:layout_height="20dp"
      android:gravity="center"
      android:text="&#8250;"
      android:textColor="@color/widget_primary"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/calendar_week_strip"
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/calendar_day_cell_0"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/widget_calendar_day_clear">
      <TextView
        android:id="@+id/calendar_day_0_dow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/calendar_day_0"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/calendar_day_cell_1"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/widget_calendar_day_clear">
      <TextView
        android:id="@+id/calendar_day_1_dow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/calendar_day_1"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/calendar_day_cell_2"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/widget_calendar_day_clear">
      <TextView
        android:id="@+id/calendar_day_2_dow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/calendar_day_2"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/calendar_day_cell_3"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/widget_calendar_day_clear">
      <TextView
        android:id="@+id/calendar_day_3_dow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/calendar_day_3"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/calendar_day_cell_4"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/widget_calendar_day_clear">
      <TextView
        android:id="@+id/calendar_day_4_dow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/calendar_day_4"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/calendar_day_cell_5"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/widget_calendar_day_clear">
      <TextView
        android:id="@+id/calendar_day_5_dow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/calendar_day_5"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/calendar_day_cell_6"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center"
      android:background="@drawable/widget_calendar_day_clear">
      <TextView
        android:id="@+id/calendar_day_6_dow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/calendar_day_6"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:paddingTop="2dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:orientation="vertical"
      android:paddingEnd="5dp">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/cal_tasks_label" android:text="TASKS"
        android:textColor="@color/widget_label"
        android:textSize="9sp"
        android:letterSpacing="0.08"
        android:textStyle="bold" />
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
          android:id="@+id/widget_tasks_list"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:divider="@null"
          android:paddingVertical="1dp" />
        <include
          android:id="@+id/widget_tasks_empty_view"
          layout="@layout/widget_empty_state" />
      </FrameLayout>
    </LinearLayout>

    <FrameLayout
      android:id="@+id/cal_col_divider"
      android:layout_width="1dp"
      android:layout_height="match_parent"
      android:layout_marginTop="2dp"
      android:layout_marginBottom="2dp"
      android:background="@color/widget_border" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:orientation="vertical"
      android:paddingStart="5dp">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/cal_habits_label" android:text="HABITS"
        android:textColor="@color/widget_label"
        android:textSize="9sp"
        android:letterSpacing="0.08"
        android:textStyle="bold" />
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
          android:id="@+id/widget_habits_list"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:divider="@null"
          android:paddingVertical="1dp" />
        <include
          android:id="@+id/widget_habits_empty_view"
          layout="@layout/widget_empty_state" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/calendar_go_to_app"
    android:layout_width="match_parent"
    android:layout_height="16dp"
    android:background="@drawable/widget_go_to_app_button"
    android:gravity="center"
    android:maxLines="1"
    android:text="Go to App"
    android:textColor="@color/widget_on_primary"
    android:textSize="10sp"
    android:textStyle="bold" />
</LinearLayout>