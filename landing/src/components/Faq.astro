---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="tk-faq">
  {
    items.map((item) => (
      <details class="tk-faq__item">
        <summary class="tk-faq__q">
          <span>{item.q}</span>
          <span class="tk-faq__sign" aria-hidden="true"></span>
        </summary>
        <div class="tk-faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>