---
import type { Lang } from "../i18n";
import { dict } from "../i18n";
import ChipBar from "./ChipBar.astro";
import PhoneMockup from "./PhoneMockup.astro";
import SplitCta from "./SplitCta.astro";
import GhostCta from "./GhostCta.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
---

<section class="tk-hero" aria-labelledby="hero-title">
  <div class="tk-container tk-hero__grid">
    <div class="tk-hero__text">
      <h1 class="tk-h1" id="hero-title" data-reveal style="--i:0">
        {t.hero.title}
      </h1>
      <p class="tk-lead" data-reveal style="--i:1">{t.hero.lead}</p>
      <div class="tk-hero__cta" data-reveal style="--i:2">
        <SplitCta href="#unduh" label={t.ctaDownload} />
        <GhostCta href="#fitur" label={t.ctaSeeFeatures} />
      </div>
      <div data-reveal style="--i:3">
        <ChipBar chips={t.hero.chips} />
      </div>
    </div>
    <div class="tk-hero__media" data-reveal style="--i:2">
      <PhoneMockup
        img="/img/otter-waving-720.webp"
        width={720}
        height={960}
        priority
        label={t.hero.phoneLabel}
        sub={t.hero.phoneSub}
      />
      <PhoneMockup
        img="/img/otter-portrait-720.webp"
        width={720}
        height={720}
        second
      />
    </div>
  </div>
</section>