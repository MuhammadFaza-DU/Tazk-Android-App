---
import { featureIcons } from "../lib/icons";

interface Props {
  title: string;
  body: string;
  icon: string;
}
const { title, body, icon } = Astro.props;
---

<article class="tk-card">
  <span class="tk-card__icon" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={featureIcons[icon] ?? ""}
    />
  </span>
  <h3>{title}</h3>
  <p class="tk-body">{body}</p>
</article>