---
import { featureIcons } from "../lib/icons";

interface Props {
  title: string;
  body: string;
  icon: string;
  featured?: boolean;
  index?: number;
}
const { title, body, icon, featured = false, index = 0 } = Astro.props;
---

<article
  class:list={["tk-card", featured && "tk-card--featured"]}
  data-reveal
  style={`--i:${index % 5}`}
>
  <span class="tk-card__icon" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={featureIcons[icon] ?? ""}
    />
  </span>
  <h3>{title}</h3>
  <p class="tk-body">{body}</p>
</article>
